<view class="page-shell profile-page">
  <view class="profile-head">
    <view class="profile-avatar">人</view>
    <view class="profile-name">{{nickname}}</view>
    <view class="muted">系统昵称</view>
  </view>
  <view class="profile-stats">
    <view wx:for="{{stats}}" wx:key="label" class="profile-stat">
      <text class="profile-stat-value">{{item.value}}</text>
      <text class="profile-stat-label">{{item.label}}</text>
    </view>
  </view>
  <view class="profile-menu">
    <view class="profile-row" bindtap="openWorks"><text>我的作品</text><text>›</text></view>
    <view class="profile-row"><text>我的收藏</text><text>›</text></view>
    <view class="profile-row"><text>内容规范</text><text>›</text></view>
  </view>
</view>
