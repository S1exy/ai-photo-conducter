.section-title { margin: 26rpx 0 18rpx; font-weight: 600; }
.template-strip { width: 100%; white-space: nowrap; }
.template-choice { display: inline-flex; width: 190rpx; margin-right: 16rpx; padding: 12rpx; border: 2rpx solid transparent; border-radius: 24rpx; background: #ffffff; flex-direction: column; gap: 10rpx; font-size: 23rpx; }
.template-choice.active { border-color: #1d4f3d; }
.template-thumb { height: 130rpx; border-radius: 18rpx; }
.template-thumb.editorial { background: linear-gradient(180deg, #eee6d7 0 61%, #bdceef 61%); }
.template-thumb.pet { background: radial-gradient(circle, #f2d684 0 18%, #d19de2 19% 44%, #8bd8c4 45%); }
.template-thumb.city { background: linear-gradient(145deg, #91d5ee, #f1af9c); }
.template-thumb.poster { background: linear-gradient(160deg, #2b385c, #e3574d); }
.selected-template { margin-top: 18rpx; padding: 20rpx; border-radius: 20rpx; background: #e9efeb; color: #385044; font-size: 24rpx; }
.upload-box { height: 430rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 2rpx dashed #aebbb4; border-radius: 30rpx; background: #ffffff; text-align: center; color: #77837c; }
.upload-box image { width: 100%; height: 100%; }
.upload-plus { margin-bottom: 12rpx; font-size: 64rpx; color: #315f4c; }
.ratio-list { display: flex; gap: 16rpx; flex-wrap: wrap; }
.ratio-choice { padding: 16rpx 28rpx; border-radius: 999rpx; background: #e9efeb; }
.ratio-choice.active { background: #183f32; color: #ffffff; }
.create-hint { margin: 34rpx 0 20rpx; color: #77837c; font-size: 23rpx; }
