.feed-page {
  padding: 92rpx 18rpx 24rpx;
}

.feed-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.feed-brand {
  font-size: 40rpx;
  font-weight: 600;
  white-space: nowrap;
}

.feed-search {
  flex: 1;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  background: #edf2ef;
  color: #859089;
  font-size: 24rpx;
}

.feed-tabs {
  display: flex;
  gap: 44rpx;
  padding: 26rpx 8rpx 18rpx;
}

.feed-tab {
  color: #7a867f;
}

.feed-tab.active {
  color: #17201d;
  font-weight: 600;
}

.waterfall {
  column-count: 2;
  column-gap: 18rpx;
}

.work-card {
  display: inline-block;
  width: 100%;
  margin-bottom: 24rpx;
  break-inside: avoid;
  vertical-align: top;
}

.work-art {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
}

.work-art.tall { height: 440rpx; }
.work-art.medium { height: 360rpx; }
.work-art.short { height: 300rpx; }
.work-art.editorial { background: linear-gradient(180deg, #eee6d7 0 61%, #bdceef 61%); }
.work-art.pet { background: radial-gradient(circle at 50% 42%, #f2d684 0 18%, #d19de2 19% 44%, #8bd8c4 45%); }
.work-art.city { background: linear-gradient(145deg, #91d5ee, #f1af9c); }
.work-art.poster { background: linear-gradient(160deg, #2b385c, #e3574d); }

.template-line {
  padding: 14rpx 4rpx 8rpx;
  color: #34473e;
  font-size: 25rpx;
  font-weight: 600;
}

.work-meta {
  display: flex;
  justify-content: space-between;
  padding: 0 4rpx;
  color: #7a867f;
  font-size: 21rpx;
}

.feed-empty {
  padding: 120rpx 0;
  text-align: center;
  color: #7a867f;
}
