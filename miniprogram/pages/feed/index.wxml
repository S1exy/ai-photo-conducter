<view class="feed-page">
  <view class="feed-header">
    <view class="feed-brand">灵感接力</view>
    <view class="feed-search">搜索模板</view>
  </view>

  <view class="feed-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="feed-tab {{activeTab === item ? 'active' : ''}}"
      data-tab="{{item}}"
      bindtap="selectTab"
    >{{item}}</view>
  </view>

  <view wx:if="{{loading}}" class="feed-empty">正在加载作品…</view>

  <view wx:elif="{{!works.length}}" class="feed-empty">还没有公开作品，去生成第一张吧。</view>

  <view wx:else class="waterfall">
    <view
      wx:for="{{works}}"
      wx:key="id"
      class="work-card"
      data-template-id="{{item.templateId}}"
      bindtap="openTemplate"
    >
      <image class="work-art {{item.heightClass}}" src="{{item.imagePath}}" mode="aspectFill"></image>
      <view class="template-line">▦ {{item.templateName}}</view>
      <view class="work-meta">
        <text>{{item.author}}</text>
        <text>♡ {{item.likes}}</text>
      </view>
    </view>
  </view>
</view>
