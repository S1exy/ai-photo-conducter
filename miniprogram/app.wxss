page {
  min-height: 100%;
  background: #f8faf8;
  color: #17201d;
  font-size: 28rpx;
}

button::after {
  border: 0;
}

.page-shell {
  padding: 24rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: #183f32;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  border-radius: 999rpx;
  background: #e9efeb;
  color: #2c3d35;
  font-size: 26rpx;
}

.muted {
  color: #77837c;
}
